[{"start": 0.0, "end": 4.92, "text": " لا تنزل ولا ستوري اليوم قبل لا تشوف الطريقة الصحيحة", "words": [[0.0, 1.54, " لا"], [1.54, 2.02, " تنزل"], [2.02, 2.22, " ولا"], [2.22, 2.62, " ستوري"], [2.62, 2.94, " اليوم"], [2.94, 3.28, " قبل"], [3.28, 3.42, " لا"], [3.42, 3.78, " تشوف"], [3.78, 4.24, " الطريقة"], [4.24, 4.92, " الصحيحة"]]}, {"start": 4.92, "end": 8.44, "text": " الزبون ما يكمل كل ستورياتك", "words": [[4.92, 6.82, " الزبون"], [6.82, 7.02, " ما"], [7.02, 7.4, " يكمل"], [7.4, 7.56, " كل"], [7.56, 8.44, " ستورياتك"]]}, {"start": 8.44, "end": 11.68, "text": " خلها ثلاثة وكل واحدة لها شغلة", "words": [[8.44, 9.28, " خلها"], [9.28, 9.84, " ثلاثة"], [9.84, 10.54, " وكل"], [10.54, 10.96, " واحدة"], [10.96, 11.2, " لها"], [11.2, 11.68, " شغلة"]]}, {"start": 12.720000000000002, "end": 16.24, "text": " الأولى توكفة سؤالي حس انك تقصدها", "words": [[12.720000000000002, 13.68, " الأولى"], [13.68, 14.22, " توكفة"], [14.22, 15.08, " سؤالي"], [15.08, 15.34, " حس"], [15.34, 15.64, " انك"], [15.64, 16.24, " تقصدها"]]}, {"start": 17.500000000000004, "end": 21.9, "text": " الثانية توريه ليابي المنتج والرقم اللي هنه", "words": [[17.500000000000004, 18.46, " الثانية"], [18.46, 18.96, " توريه"], [18.96, 19.5, " ليابي"], [19.5, 20.56, " المنتج"], [20.56, 21.28, " والرقم"], [21.28, 21.42, " اللي"], [21.42, 21.9, " هنه"]]}, {"start": 23.78, "end": 28.08, "text": " الثالثة تخليه يطلب زر واحد ولا تخليه يفكر", "words": [[23.78, 24.74, " الثالثة"], [24.74, 25.2, " تخليه"], [25.2, 25.56, " يطلب"], [25.56, 26.34, " زر"], [26.34, 26.88, " واحد"], [26.88, 27.32, " ولا"], [27.32, 27.76, " تخليه"], [27.76, 28.08, " يفكر"]]}, {"start": 30.599999999999998, "end": 34.6, "text": " ثلاثة ستوريات كل واحدة تسوي شغلها", "words": [[30.599999999999998, 31.72, " ثلاثة"], [31.72, 32.38, " ستوريات"], [32.38, 32.94, " كل"], [32.94, 33.5, " واحدة"], [33.5, 34.02, " تسوي"], [34.02, 34.6, " شغلها"]]}, {"start": 38.17999999999999, "end": 43.34, "text": " تابعي قوالب ستوري جاهزة لبراندك ارسل لي ستوري بالدايركت",